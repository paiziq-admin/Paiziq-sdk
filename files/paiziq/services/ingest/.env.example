# Paiziq ingest service configuration (see config.py for validation rules).
# Copy to .env and adjust; never commit real keys.

# "development" (permissive defaults) or "production" (fail-fast validation)
PAIZIQ_ENV=development

# SQLite database path. Production refuses ":memory:".
PAIZIQ_INGEST_DB=:memory:

# Comma-separated API keys. Production refuses the "dev-key" default.
PAIZIQ_INGEST_KEYS=dev-key

# Request limits (optional overrides)
#PAIZIQ_MAX_BODY_BYTES=1000000
#PAIZIQ_MAX_SPANS_PER_BATCH=500

# Logging level name (DEBUG/INFO/WARNING/ERROR)
PAIZIQ_LOG_LEVEL=INFO

# Rate limit (requests/minute; default 600 dev, 120 production)
#PAIZIQ_RATE_LIMIT_RPM=600

# Comma-separated CORS origins (empty = disabled)
#PAIZIQ_CORS_ORIGINS=http://localhost:8900

# Optional Fernet master key for webhook secret encryption at rest
#PAIZIQ_SECRETS_KEY=

# Review SLA for open reviews (milliseconds; default 24h)
#PAIZIQ_REVIEW_SLA_MS=86400000

# Retention purge (days; audit requires >=365 when set)
#PAIZIQ_RETENTION_SPANS_DAYS=90
#PAIZIQ_RETENTION_NOTIFICATIONS_DAYS=30
#PAIZIQ_RETENTION_AUDIT_DAYS=
