# Configuration for deploy/azure/deploy_backend.sh.
# Copy to backend.env (gitignored) and fill in the values, or export the
# variables in your shell.
#
#   set -a; source deploy/azure/backend.env; set +a
#   make deploy-azure

# --- Azure resources -------------------------------------------------------
# Existing subscription and resource group from the integration guide.
AZ_SUBSCRIPTION=8406cce0-3a67-4d8e-b536-965b930989af
AZ_RESOURCE_GROUP=paiziq-dev
AZ_LOCATION=centralus

# Globally unique, lowercase letters and digits only (5-50 chars for ACR,
# 3-24 chars for the storage account). Change these before the first run.
AZ_ACR_NAME=paiziqdevacr01
AZ_STORAGE_ACCOUNT=paiziqdevdata01

# Names inside the resource group; defaults are fine.
AZ_ACA_ENV=paiziq-dev-env
AZ_APP_NAME=paiziq-ingest-dev
AZ_FILE_SHARE=paiziq-ingest-data
AZ_STORAGE_LINK=paiziq-data

# Image tag; defaults to the short git SHA when unset.
# IMAGE_TAG=

# --- Paiziq runtime settings (injected into the container) -----------------
# Strong bootstrap admin key(s), comma-separated. Generate with:
#   python3 -c "import secrets; print('pzq_admin_' + secrets.token_urlsafe(32))"
# Never use dev-key here; production mode rejects it.
PAIZIQ_INGEST_KEYS=

# Exact browser origin(s) of the dashboard, comma-separated, no trailing slash.
PAIZIQ_CORS_ORIGINS=https://brave-river-0a6dd1310.5.azurestaticapps.net

# Optional. Stable Fernet key to encrypt stored webhook secrets:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PAIZIQ_SECRETS_KEY=

# Optional tuning (defaults shown).
PAIZIQ_LOG_LEVEL=INFO
PAIZIQ_RATE_LIMIT_RPM=240
# PAIZIQ_REVIEW_SLA_MS=86400000
